# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string for Prisma ORM & @prisma/adapter-pg
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# TELEGRAM_BOT_TOKEN: Telegram Bot Token from @BotFather for instant registration alerts
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# TELEGRAM_CHAT_ID: Telegram Chat ID or Channel ID where course registration alerts are delivered
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"
